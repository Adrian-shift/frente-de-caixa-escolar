<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox prefHeight="638.0" prefWidth="891.0" styleClass="tela" stylesheets="@estilo.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ifba.cantinapdv.controller.CaixaController">
    <children>

        <!-- PAINEL DE PRODUTOS (os botões são criados pelo Java, lendo do banco) -->
        <VBox prefHeight="466.0" prefWidth="491.0" HBox.hgrow="ALWAYS">
            <children>
                <Label text="Terminal de Vendas">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </Label>

                <FlowPane fx:id="painelProdutos" hgap="15.0" vgap="15.0" />
            </children>
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
        </VBox>

        <!-- PAINEL DO CARRINHO E PAGAMENTO -->
        <VBox prefHeight="200.0" prefWidth="400.0" styleClass="painel-pedido">
            <children>
                <Label text="Pedido Atual">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Label>

                <!-- Lista onde os itens comprados aparecem -->
                <ListView fx:id="listaCarrinho" prefHeight="200.0" prefWidth="200.0" styleClass="lista-carrinho" VBox.vgrow="ALWAYS">
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </ListView>

                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnRemoverItem" graphicTextGap="8.0" maxWidth="Infinity" mnemonicParsing="false" styleClass="botao-acao, acao-neutra" text="Remover item" HBox.hgrow="ALWAYS">
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                    <image>
                                        <Image url="@icones/remover.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="btnLimparPedido" graphicTextGap="8.0" maxWidth="Infinity" mnemonicParsing="false" styleClass="botao-acao, acao-perigo" text="Limpar pedido" HBox.hgrow="ALWAYS">
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                    <image>
                                        <Image url="@icones/limpar.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </HBox>

                <!-- TOTAL em destaque -->
                <HBox alignment="CENTER_LEFT" styleClass="caixa-total">
                    <children>
                        <Label text="TOTAL: ">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <Label fx:id="labelTotal" text="R$ 0,00" textFill="#c0392b">
                            <font>
                                <Font name="System Bold" size="30.0" />
                            </font>
                        </Label>
                    </children>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </HBox>

                <!-- Formas de pagamento (a cor de cada botão vem do CSS; o escolhido fica verde) -->
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnDinheiro" graphicTextGap="8.0" maxWidth="Infinity" mnemonicParsing="false" styleClass="botao-pagamento" text="Dinheiro (F1)" HBox.hgrow="ALWAYS">
                            <graphic>
                                <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
                                    <image>
                                        <Image url="@icones/dinheiro.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="btnCartao" graphicTextGap="8.0" maxWidth="Infinity" mnemonicParsing="false" styleClass="botao-pagamento" text="Cartão (F2)" HBox.hgrow="ALWAYS">
                            <graphic>
                                <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
                                    <image>
                                        <Image url="@icones/cartao.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="btnPix" graphicTextGap="8.0" maxWidth="Infinity" mnemonicParsing="false" styleClass="botao-pagamento" text="PIX (F3)" HBox.hgrow="ALWAYS">
                            <graphic>
                                <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
                                    <image>
                                        <Image url="@icones/pix.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </HBox>

                <!-- Valor Recebido e Troco -->
                <HBox spacing="15.0">
                    <children>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Valor Recebido (R$)" textFill="#555555">
                                    <font><Font name="System Bold" size="12.0" /></font>
                                </Label>
                                <TextField fx:id="campoValorRecebido" promptText="0,00">
                                    <font><Font size="20.0" /></font>
                                </TextField>
                            </children>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Troco (R$)" textFill="#555555">
                                    <font><Font name="System Bold" size="12.0" /></font>
                                </Label>
                                <TextField fx:id="campoTroco" editable="false" promptText="0,00" styleClass="campo-troco">
                                    <font><Font name="System Bold" size="20.0" /></font>
                                </TextField>
                            </children>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="6.0" />
                    </VBox.margin>
                </HBox>

                <!-- Aviso em vermelho (ex.: "Faltam R$ 3,00") -->
                <Label fx:id="labelAviso" minHeight="22.0" styleClass="aviso-erro" text="" wrapText="true">
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Label>

                <Button fx:id="btnFinalizar" graphicTextGap="12.0" maxWidth="Infinity" mnemonicParsing="false" styleClass="botao-finalizar" text="FINALIZAR VENDA (ENTER)">
                    <graphic>
                        <ImageView fitHeight="28.0" fitWidth="28.0" preserveRatio="true">
                            <image>
                                <Image url="@icones/finalizar.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </children>
</HBox>
